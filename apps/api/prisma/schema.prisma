generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  creator
  moderator
  admin
}

enum DocStatus {
  DRAFT
  REVIEW
  PUBLISHED
  TAKEDOWN
}

enum BazarStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PAID
  ESCROW
  RELEASED
  REFUNDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nulo en cuentas 100% OAuth (sin contraseña local). El login con clave
  // las rechaza con OAUTH_ONLY en lugar de romper.
  passwordHash String?
  // Proveedor OAuth vinculado (google|apple). provider+providerId únicos.
  provider     String?
  providerId   String?
  avatarUrl    String?
  role         Role     @default(student)
  createdAt    DateTime @default(now())
  profile      Profile?
  documents    Document[]
  bazarItems   BazarItem[]
  orders       Order[]  @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("OrdersAsSeller")
  uploads      Upload[]
  passwordChangedAt DateTime?
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  reports      Report[]
  refreshTokens RefreshToken[]
  savedDocuments SavedDocument[]
  @@unique([provider, providerId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  university  String  @default("UNSA")
  career      String  @default("ENFERMERIA")
  cycle       String?
  // Onboarding (spec 21): nulo = perfil obligatorio pendiente.
  faculty     String?
  phone       String?
  onboardedAt DateTime?
  hospital    String?
  cepCode     String?
  cepVerified Boolean @default(false)
}

model Document {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  course      String
  university  String   @default("UNSA")
  career      String   @default("ENFERMERIA")
  cycle       String
  type        String    // APUNTE | PAE | BALOTARIO | GUIA
  priceCents  Int       @default(0)
  fileUrl     String?
  // Páginas de muestra públicas (spec 16): el resto solo con pago verificado.
  previewPages Int[]    @default([1, 2])
  description String?
  payMethod   String    @default("YAPE")
  payQrUrl    String?
  payDetail   String?
  status      DocStatus @default(PUBLISHED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  savedBy     SavedDocument[]

  @@index([university, career, status])
  @@index([title])
  @@index([authorId])
}

// Guardados (bookmark) del Visor: un registro por usuario+documento.
model SavedDocument {
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  @@index([userId, createdAt])
}

model BazarItem {
  id           String      @id @default(cuid())
  sellerId     String
  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  kind         String      // LIBRO | SCRUB | INSTRUMENTO
  tx           String      // VENTA | ALQUILER
  priceCents   Int
  depositCents Int?
  description  String?
  photos       String[]    @default([])
  payMethod    String      @default("YAPE")
  payQrUrl     String?
  payDetail    String?
  status       BazarStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([sellerId])
}

model Order {
  id         String      @id @default(cuid())
  buyerId    String
  buyer      User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  // Vendedor materializado al crear el pedido (Sprint 1A): evita resolverlo
  // vía Document.authorId / BazarItem.sellerId en cada lectura y habilita
  // índices por vendedor + notificaciones.
  sellerId   String
  seller     User        @relation("OrdersAsSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  itemType   String      // document | bazar (minúsculas)
  itemId     String
  amountCents Int
  feeCents   Int
  netCents   Int
  // Snapshot congelado al crear el pedido (Sprint 1A): el precio y la tasa
  // vigentes al reservar. Cambios posteriores del ítem no reescriben historia.
  itemTitle      String
  itemPriceCents Int
  feeBps         Int
  // Foto del cobro al crear el pedido (método + QR + dato del vendedor).
  payMethod  String?
  payQrUrl   String?
  payDetail  String?
  // Constancia que declara el comprador (n° operación Yape/Plin).
  payProof   String?
  // Captura opcional del voucher (spec 09): ruta /uploads/<uuid> validada.
  payProofUrl String?
  // Alquiler de bazar: periodo solicitado por el comprador.
  rentalStart DateTime?
  rentalEnd   DateTime?
  // Reserva con TTL (Sprint 1A): expiresAt solo vive mientras PENDING.
  // Al aceptar/pagar/cancelar/expirar se limpia a null.
  expiresAt       DateTime?
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  status     OrderStatus @default(PENDING)
  escrow     Escrow?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Índices parciales en SQL (Prisma no los expresa): ver migración
  // sprint1a_reservation_ttl (order_active_item_unique y siguientes).
  // Rendimiento de lectura (F0-c p95): /sales filtra por itemId y ordena por
  // createdAt; el groupBy de completadas filtra por buyerId+status.
  @@index([itemId, createdAt(sort: Desc)])
  @@index([buyerId, status])
}

model Escrow {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String?
  reporter   User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Sprint F1-01: tokens de recuperación (se guarda solo el sha256, nunca el token).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Sprint F1-08: notificaciones in-app (campana). El email es opt-in posterior.
enum NotificationType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_PAID
  ORDER_RELEASED
  ORDER_EXPIRED
  ORDER_CANCELLED
  REPORT_RESOLVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// Sprint 4 (F4-01): registro de archivos subidos. Permite verificar firma,
// deduplicar por checksum y aplicar autorización al servir.
model Upload {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storedName   String   @unique
  originalName String
  bytes        Int
  detectedMime String
  checksum     String
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([checksum])
}

// Spec 22: códigos de ingreso por correo institucional (6 dígitos, 10 min,
// máx. 5 intentos). Solo se guarda el HMAC, nunca el código. Sin FK: el
// usuario puede no existir aún (se crea al canjear el primer código).
model EmailLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}
