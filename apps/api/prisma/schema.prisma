generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  creator
  moderator
  admin
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocStatus {
  DRAFT
  REVIEW
  PUBLISHED
  TAKEDOWN
}

enum BazarStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PAID
  ESCROW
  RELEASED
  REFUNDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nulo en cuentas 100% OAuth (sin contraseña local). El login con clave
  // las rechaza con OAUTH_ONLY en lugar de romper.
  passwordHash String?
  // Proveedor OAuth vinculado (google|apple). provider+providerId únicos.
  provider     String?
  providerId   String?
  avatarUrl    String?
  role         Role     @default(student)
  createdAt    DateTime @default(now())
  profile      Profile?
  documents    Document[]
  bazarItems   BazarItem[]
  orders       Order[]  @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("OrdersAsSeller")
  uploads      Upload[]
  passwordChangedAt DateTime?
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  reports      Report[]
  refreshTokens RefreshToken[]
  collectedPayouts Payout[] @relation("PayoutCollector")
  payouts Payout[] @relation("PayoutSeller")
  documentGrants DocumentAccessGrant[]
  paymentAccounts PaymentAccount[]
  assignedCases HandoverCase[]
  partyAppointments Appointment[] @relation("AppointmentParty")
  staffAppointments Appointment[] @relation("AppointmentStaff")
  staffShifts StaffShift[]
  caseMessages CaseMessage[]
  strikes Strike[] @relation("StrikeUser")
  strikesForgiven Strike[] @relation("StrikeForgiver")
  reviewsReceived UserReview[] @relation("ReviewSubject")
  reviewsWritten UserReview[] @relation("ReviewAuthor")
  sanctions Sanction[] @relation("SanctionUser")
  sanctionsApplied Sanction[] @relation("SanctionBy")
  sanctionsLifted Sanction[] @relation("SanctionLiftedBy")
  savedDocuments SavedDocument[]
  @@unique([provider, providerId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  university  String  @default("UNSA")
  career      String  @default("ENFERMERIA")
  cycle       String?
  // Onboarding (spec 21): nulo = perfil obligatorio pendiente.
  faculty     String?
  phone       String?
  onboardedAt DateTime?
  hospital    String?
  cepCode     String?
  cepVerified Boolean @default(false)
}

model Document {
  id          String    @id @default(cuid())
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  course      String
  university  String   @default("UNSA")
  career      String   @default("ENFERMERIA")
  cycle       String
  type        String    // APUNTE | PAE | BALOTARIO | GUIA
  priceCents  Int       @default(0)
  fileUrl     String?
  // Páginas de muestra públicas (spec 16): el resto solo con pago verificado.
  previewPages Int[]    @default([1, 2])
  description String?
  payMethod   String    @default("YAPE")
  payQrUrl    String?
  payDetail   String?
  reviewStatus ReviewStatus @default(APPROVED)
  reviewNote String?
  reviewedAt DateTime?
  reviewedById String?
  status      DocStatus @default(PUBLISHED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  grants      DocumentAccessGrant[]
  savedBy     SavedDocument[]

  @@index([university, career, status])
  @@index([title])
  @@index([authorId])
  @@index([reviewStatus, createdAt])
}

// Guardados (bookmark) del Visor: un registro por usuario+documento.
model SavedDocument {
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([userId, documentId])
  @@index([userId, createdAt])
}

model BazarItem {
  id           String      @id @default(cuid())
  sellerId     String
  seller       User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  kind         String      // LIBRO | SCRUB | INSTRUMENTO
  tx           String      // VENTA | ALQUILER
  priceCents   Int
  depositCents Int?
  description  String?
  photos       String[]    @default([])
  payMethod    String      @default("YAPE")
  payQrUrl     String?
  payDetail    String?
  reviewStatus ReviewStatus @default(APPROVED)
  reviewNote String?
  reviewedAt DateTime?
  reviewedById String?
  status       BazarStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([sellerId])
  @@index([reviewStatus, createdAt])
}

model Order {
  id         String      @id @default(cuid())
  buyerId    String
  buyer      User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  // Vendedor materializado al crear el pedido (Sprint 1A): evita resolverlo
  // vía Document.authorId / BazarItem.sellerId en cada lectura y habilita
  // índices por vendedor + notificaciones.
  sellerId   String
  seller     User        @relation("OrdersAsSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  itemType   String      // document | bazar (minúsculas)
  itemId     String
  amountCents Int
  feeCents   Int
  netCents   Int
  // Snapshot congelado al crear el pedido (Sprint 1A): el precio y la tasa
  // vigentes al reservar. Cambios posteriores del ítem no reescriben historia.
  itemTitle      String
  itemPriceCents Int
  feeBps         Int
  // Foto del cobro al crear el pedido (método + QR + dato del vendedor).
  payMethod  String?
  payQrUrl   String?
  payDetail  String?
  // Constancia que declara el comprador (n° operación Yape/Plin).
  payProof   String?
  // Captura opcional del voucher (spec 09): ruta /uploads/<uuid> validada.
  payProofUrl String?
  // Alquiler de bazar: periodo solicitado por el comprador.
  rentalStart DateTime?
  rentalEnd   DateTime?
  // Reserva con TTL (Sprint 1A): expiresAt solo vive mientras PENDING.
  // Al aceptar/pagar/cancelar/expirar se limpia a null.
  expiresAt       DateTime?
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  status     OrderStatus @default(PENDING)
  paymentAccountId String?
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  payHolder String?
  payPhotoUrl String?
  sellerPayMethod String?
  sellerPayDetail String?
  sellerPayQrUrl String?
  proofSubmittedAt DateTime?
  paymentRejectedReason String?
  paymentReviewedAt DateTime?
  paymentReviewedById String?
  verifiedAt DateTime?
  payout Payout?
  documentGrant DocumentAccessGrant?
  handoverCase HandoverCase?
  escrow     Escrow?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Índices parciales en SQL (Prisma no los expresa): ver migración
  // sprint1a_reservation_ttl (order_active_item_unique y siguientes).
  // Rendimiento de lectura (F0-c p95): /sales filtra por itemId y ordena por
  // createdAt; el groupBy de completadas filtra por buyerId+status.
  @@index([itemId, createdAt(sort: Desc)])
  @@index([buyerId, status])
}

model Escrow {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  releasedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Report {
  id         String   @id @default(cuid())
  reporterId String?
  reporter   User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String
  targetId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Sprint F1-01: tokens de recuperación (se guarda solo el sha256, nunca el token).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Sprint F1-08: notificaciones in-app (campana). El email es opt-in posterior.
enum NotificationType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_PAID
  ORDER_RELEASED
  ORDER_EXPIRED
  ORDER_CANCELLED
  REPORT_RESOLVED
  REVIEW_APPROVED
  REVIEW_REJECTED
  STAFF_ADDED
  STAFF_REMOVED
  ORDER_CASE_ASSIGNED
  ORDER_APPOINTMENT_SCHEDULED
  ORDER_APPOINTMENT_NO_SHOW
  ORDER_IN_CUSTODY
  ORDER_PICKUP_COMPLETED
  ORDER_RETURN_COMPLETED
  CASE_MESSAGE
  ORDER_APPOINTMENT_REMINDER
  SANCTION_APPLIED
  SANCTION_LIFTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  PAYOUT_PENDING
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// Sprint 4 (F4-01): registro de archivos subidos. Permite verificar firma,
// deduplicar por checksum y aplicar autorización al servir.
model Upload {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  private      Boolean  @default(false)
  storedName   String   @unique
  originalName String
  bytes        Int
  detectedMime String
  checksum     String
  createdAt    DateTime @default(now())

  @@index([ownerId])
  @@index([checksum])
}

// Spec 22: códigos de ingreso por correo institucional (6 dígitos, 10 min,
// máx. 5 intentos). Solo se guarda el HMAC, nunca el código. Sin FK: el
// usuario puede no existir aún (se crea al canjear el primer código).
model EmailLoginCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Sede {
  id String @id @default(cuid())
  name String @unique
  address String @default("")
  meetingPoint String @default("")
  photoUrl String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases HandoverCase[]
  appointments Appointment[]
  shifts StaffShift[]
}

model OpeningHours {
  weekday Int @id
  opens Int
  closes Int
  special Boolean @default(false)
}

model Holiday {
  id String @id @default(cuid())
  date DateTime @unique @db.Date
  reason String
}

model StaffShift {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  sedeId String
  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  weekday Int
  startsMin Int
  endsMin Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointments Appointment[]
  @@index([userId, weekday])
  @@index([sedeId, weekday])
}

enum CaseStatus {
  UNASSIGNED
  ASSIGNED
  DROP_SCHEDULED
  IN_CUSTODY
  PICKUP_SCHEDULED
  DELIVERED
  RENTED_OUT
  RETURN_SCHEDULED
  RETURNED
  BACK_TO_SELLER
  CLOSED
  CANCELLED
}

enum AppointmentKind {
  DROP_OFF
  PICKUP
  RETURN
  BACK_TO_SELLER
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELLED
}

model HandoverCase {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  status CaseStatus @default(UNASSIGNED)
  sedeId String?
  sede Sede? @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  receivedPhotoUrl String?
  conditionNote String?
  receivedAt DateTime?
  paymentRef String?
  paymentMethod String?
  sellerConfirmedAt DateTime?
  returnCondition String?
  returnConditionNote String?
  returnPhotoUrl String?
  returnedAt DateTime?
  returnWindowStart DateTime?
  returnDeadlineAt DateTime?
  backToSellerRequestedAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appointments Appointment[]
  messages CaseMessage[]
  reviews UserReview[]
  @@index([assigneeId, status, createdAt])
}

model Appointment {
  id String @id @default(cuid())
  caseId String
  case HandoverCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  kind AppointmentKind
  partyId String
  party User @relation("AppointmentParty", fields: [partyId], references: [id], onDelete: Restrict)
  staffId String
  staff User @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: Restrict)
  sedeId String
  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  shiftId String?
  shift StaffShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  startsAt DateTime
  endsAt DateTime
  status AppointmentStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  strike Strike?
  rescheduledFromId String? @unique
  rescheduledFrom Appointment? @relation("RescheduledAppointment", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  replacement Appointment? @relation("RescheduledAppointment")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([staffId, status, startsAt])
  @@index([caseId, kind])
}

model CaseMessage {
  id String @id @default(cuid())
  caseId String
  case HandoverCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body String
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
}

enum SanctionKind {
  WARNING
  SUSPENSION
  BAN
}

model Strike {
  id String @id @default(cuid())
  userId String
  user User @relation("StrikeUser", fields: [userId], references: [id], onDelete: Restrict)
  appointmentId String @unique
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  forgivenAt DateTime?
  forgivenById String?
  forgivenBy User? @relation("StrikeForgiver", fields: [forgivenById], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
}

model UserReview {
  id String @id @default(cuid())
  subjectId String
  subject User @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)
  authorId String
  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  caseId String?
  case HandoverCase? @relation(fields: [caseId], references: [id], onDelete: Restrict)
  score Int
  comment String @default("")
  createdAt DateTime @default(now())
  @@unique([authorId, subjectId, caseId])
  @@index([subjectId, createdAt])
}

model Sanction {
  id String @id @default(cuid())
  userId String
  user User @relation("SanctionUser", fields: [userId], references: [id], onDelete: Restrict)
  kind SanctionKind
  reason String
  startsAt DateTime @default(now())
  endsAt DateTime?
  auto Boolean @default(false)
  byId String?
  by User? @relation("SanctionBy", fields: [byId], references: [id], onDelete: Restrict)
  liftedAt DateTime?
  liftedById String?
  liftedBy User? @relation("SanctionLiftedBy", fields: [liftedById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([userId, liftedAt, endsAt])
}

model PaymentAccount {
  orders Order[]
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  method String
  holder String
  number String
  photoUrl String
  qrUrl String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, active])
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FROZEN
}

model Payout {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerId String
  seller User @relation("PayoutSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  collectorId String
  collector User @relation("PayoutCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  amountCents Int
  feeCents Int
  netCents Int
  payMethod String?
  payDetail String?
  payQrUrl String?
  status PayoutStatus @default(PENDING)
  dueAt DateTime
  proofUrl String?
  paymentRef String?
  completedAt DateTime?
  completedById String?
  frozenReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([collectorId, status, dueAt])
  @@index([sellerId, createdAt])
}

model DocumentAccessGrant {
  id String @id @default(cuid())
  buyerId String
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  documentId String
  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fileUrl String
  authorId String
  grantedAt DateTime @default(now())
  @@unique([buyerId, documentId])
}
