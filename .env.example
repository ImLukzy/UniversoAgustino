# ---- Root ----
NODE_ENV=development

# ---- API ----
API_PORT=4000
API_PREFIX=/api/v1
WEB_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=cambia-este-access-secret-localhost-min-32-chars
JWT_REFRESH_SECRET=cambia-este-refresh-secret-localhost-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Postgres:
# - Con Docker: postgresql://hub:hub123@localhost:5432/enfermeria_hub?schema=public (docker compose up -d postgres)
# - SIN Docker (actual, scripts/pg-local.ps1 en puerto 5433):
DATABASE_URL=postgresql://hub:hub123@localhost:5433/enfermeria_hub?schema=public
REDIS_URL=redis://localhost:6379

# Comision plataforma (13% por defecto, configurable)
PLATFORM_FEE_PCT=13

# Sprint 1A: TTL de reservas PENDING en minutos + job de expiración
RESERVATION_TTL_MINUTES=30
ENABLE_JOBS=false
# Conexión directa SIN pooler (deriva de DATABASE_URL quitando "-pooler" del host).
# No pongas credenciales reales en este archivo de ejemplo.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@<host-directo-neon>:5432/neondb?sslmode=require

# Storage local (dev). En prod S3-compatible (ver docs/storage-r2.md).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=25
# Cloudflare R2 (solo con STORAGE_DRIVER=s3):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ua-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=

# Pasarela de pago (spec 16, ver docs/payments.md). Vacías = cobro manual
# Yape/Plin: el comprador paga al vendedor y el vendedor confirma el abono.
# Con ambas, Checkout Pro de Mercado Pago (credenciales de TEST en dev).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# MP_API_BASE=https://api.mercadopago.com
# URL pública HTTPS de la API para el webhook (en dev: túnel tipo ngrok).
# API_PUBLIC_URL=https://<tu-tunel>.ngrok-free.app

# OAuth institucional (ver docs/oauth.md). Vacías = el botón muestra
# "aún no disponible". La redirect URI debe coincidir con la registrada en
# Google Cloud Console (tipo "Aplicación web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Correo (spec 22: código de ingreso al correo UNSA; también recuperación).
# console = imprime el código en la terminal de la API (solo desarrollo; en
# producción el ingreso por correo se apaga). resend = envío real vía Resend.
MAIL_DRIVER=console
# RESEND_API_KEY=
# MAIL_FROM=Universo Agustino <no-reply@tu-dominio-verificado.pe>

# ---- Web ----
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=EnfermeriaHub Arequipa
